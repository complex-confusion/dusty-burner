{
    "name": "lunacode/display-dust-data",
    "description": "This plugin displays Dust's complete data including camps, art, schedule, and music from regional Burning Man events or from Burning Man itself.",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Lunacode\\DisplayDustData\\": "includes/"
        }
    },
    "authors": [
        {
            "name": "Michael Greisman"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
